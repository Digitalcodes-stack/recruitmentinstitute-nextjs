# ══════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT — fill in before deploying
#  DO NOT commit this file with real values
# ══════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────
# For Next.js / Prisma (standard postgresql://)
NEXTJS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/recruitmentinstitute?sslmode=require

# For FastAPI / asyncpg (postgresql+asyncpg://)
FASTAPI_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/recruitmentinstitute

# ── Auth secrets (generate with: openssl rand -base64 32) ──
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE
NEXTJS_SECRET=GENERATE_A_DIFFERENT_STRONG_SECRET_HERE

# ── Internal API key (shared between Next.js and FastAPI) ──
SERVICE_API_KEY=GENERATE_ANOTHER_STRONG_SECRET_HERE

# ── Email (optional — set EMAIL_ENABLED=true to activate) ──
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=digitalaimlsystem@gmail.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_FROM_EMAIL=digitalaimlsystem@gmail.com
SMTP_FROM_NAME=Recruitment Institute

# ── Public URL (set after first deploy) ──────────────
NEXT_PUBLIC_BASE_URL=https://YOUR-CLOUDRUN-URL.run.app
FASTAPI_BASE_URL=https://YOUR-FASTAPI-CLOUDRUN-URL.run.app
