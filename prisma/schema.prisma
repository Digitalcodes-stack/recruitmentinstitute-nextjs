generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id         Int       @id @default(autoincrement())
  name       String
  middleName String?   @map("m_name")
  lastName   String?   @map("l_name")
  email      String    @unique
  contact    String?
  password   String
  role       AdminRole @default(ADMIN)
  image      String?
  isActive   Boolean   @default(true) @map("status")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  notificationPreference NotificationPreference?

  @@map("user_admin")
}

model Student {
  id          Int          @id @default(autoincrement())
  name        String
  contact     String?
  email       String       @unique
  password    String
  isActive    Boolean      @default(false) @map("status")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  assignmentSubmissions AssignmentSubmission[]
  feeAccounts StudentFeeAccount[]

  @@map("login_student")
}

model Membership {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String   @unique
  password  String
  isActive  Boolean  @default(false) @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("login_membership")
}

model Candidate {
  id            Int       @id @default(autoincrement())
  name          String
  mobile        String?
  email         String    @unique
  password      String
  birthdate     DateTime?
  gender        String?
  address       String?
  streetAddress String?   @map("street_address")
  city          String?
  state         String?
  zip           String?
  phone         String?
  courseSelect  String?   @map("course_select")
  comments      String?
  acceptSignin  Int       @default(0) @map("accept_signin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("candidate_login")
}

model CommunityUser {
  id        Int        @id @default(autoincrement())
  name      String
  mobile    String?
  email     String     @unique
  password  String
  createdAt DateTime   @default(now()) @map("created_at")
  answers   Answer[]
  questions Question[]

  @@map("registers")
}

model CourseCategory {
  id        Int            @id @default(autoincrement()) @map("course_category_id")
  name      String         @map("course_category")
  slug      String         @unique @map("course_href_tag")
  createdAt DateTime       @default(now()) @map("cr_date")
  courses   Course[]
  experts   Expert[]
  faqs      Faq[]
  fees      CourseFee[]
  reviews   CourseReview[]

  @@map("course_category")
}

model Course {
  id            Int            @id @default(autoincrement())
  title         String
  description   String         @db.VarChar(5000)
  categoryId    Int            @map("course_category_id")
  totalStudents Int            @default(0) @map("total_stud")
  rating        Decimal?       @db.Decimal(3, 1)
  review        String?
  courseBy      String?        @map("course_by")
  startDate     DateTime?      @map("start_date") @db.Date
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  category      CourseCategory @relation(fields: [categoryId], references: [id])
  batches       Batch[]
  modules       Module[]
  feeAccounts   StudentFeeAccount[]

  @@map("courses")
}

model Expert {
  id         Int            @id @default(autoincrement()) @map("e_id")
  title      String
  profession String?        @map("prof")
  image      String?
  categoryId Int            @map("course_category_id")
  category   CourseCategory @relation(fields: [categoryId], references: [id])

  @@map("expert")
}

model CourseFee {
  id         Int            @id @default(autoincrement())
  courseName String         @map("course")
  categoryId Int            @map("course_category_id")
  fees       Decimal?       @db.Decimal(10, 2)
  discount   Decimal?       @db.Decimal(10, 2)
  total      Decimal?       @db.Decimal(10, 2)
  feeTotal   Decimal?       @map("fee_total") @db.Decimal(10, 2)
  subtotal   Decimal?       @db.Decimal(10, 2)
  finalTotal Decimal?       @map("final_total") @db.Decimal(10, 2)
  couponCode String?        @map("coupon_code")
  category   CourseCategory @relation(fields: [categoryId], references: [id])
  feeAccounts StudentFeeAccount[]

  @@map("fees")
}

model CourseReview {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  rating      Int            @default(0)
  review      String?
  status      String         @default("pending")
  categoryId  Int            @map("course_category_id")
  category    CourseCategory @relation(fields: [categoryId], references: [id])

  @@map("reviews")
}

model Blog {
  id              Int       @id @default(autoincrement()) @map("blog_id")
  title           String    @map("blog_title")
  slug            String    @unique @map("title_url")
  content         String    @map("blog_desc")
  publishedAt     String?   @map("blog_date")
  author          String?   @map("blog_by")
  metaTitle       String?   @map("meta_title")
  metaKeywords    String?   @map("meta_keyword")
  metaDescription String?   @map("meta_desc")
  canonicalUrl    String?   @map("meta_canonical_href")
  featuredImage   String?   @map("item_image")
  isPublished     Boolean   @default(true) @map("status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  customScript    String?   @map("custom_script")
  schemaScript    String?   @map("schema_script")
  blogFaqs        BlogFaq[]

  @@map("blog")
}

model BlogFaq {
  id       Int    @id @default(autoincrement())
  blogId   Int    @map("blog_id")
  question String
  answer   String
  sortOrder Int   @default(0) @map("sort_order")
  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("blog_faqs")
}

model Faq {
  id         Int             @id @default(autoincrement()) @map("f_id")
  question   String
  answer     String
  categoryId Int?            @map("course_category_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  category   CourseCategory? @relation(fields: [categoryId], references: [id])

  @@map("faq")
}

model FaqCategory {
  id    Int    @id @default(autoincrement())
  title String

  @@map("faq_category")
}

model KnowledgeItem {
  id        Int      @id @default(autoincrement()) @map("question_id")
  question  String
  answer    String
  date      String?
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_items")
}

model Question {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  question  String
  createdAt DateTime      @default(now()) @map("created_at")
  answers   Answer[]
  user      CommunityUser @relation(fields: [userId], references: [id])

  @@map("questions")
}

model Answer {
  id         Int           @id @default(autoincrement())
  questionId Int           @map("question_id")
  userId     Int           @map("user_id")
  answer     String
  isApproved Boolean       @default(false) @map("is_approved")
  createdAt  DateTime      @default(now()) @map("created_at")
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       CommunityUser @relation(fields: [userId], references: [id])

  @@map("answers")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.VarChar(2000)
  mobile    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tbl_contactus")
}

model CourseLead {
  id        Int      @id @default(autoincrement()) @map("v_id")
  firstName String   @map("name")
  lastName  String?  @map("lname")
  email     String
  contact   String?
  flag      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("course_leads")
}

model FeesLead {
  id          Int       @id @default(autoincrement()) @map("fv_id")
  firstName   String    @map("name")
  lastName    String?   @map("lname")
  email       String
  contact     String?
  visitorDate DateTime? @map("visitor_date") @db.Date
  flag        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("fees_leads")
}

model Subscriber {
  id        Int      @id @default(autoincrement()) @map("mail_id")
  email     String   @unique
  ipAddress String?  @map("ip_address")
  isActive  Boolean  @default(true) @map("status")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribe_email")
}

model AboutSection {
  id          Int      @id @default(autoincrement()) @map("about_us_id")
  image       String?
  title       String?
  subtitle    String?  @map("title1")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("about_us")
}

model StudyWithUs {
  id          Int     @id @default(autoincrement()) @map("study_id")
  image       String?
  title       String?
  description String?

  @@map("study_with_us")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique @map("title_url")
  description String?
  image       String?
  isActive    Boolean  @default(true) @map("status")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  author      String?
  image       String?
  rating      Int      @default(5)
  isActive    Boolean  @default(true) @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model ClientLogo {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String
  website   String?
  isActive  Boolean  @default(true) @map("status")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("client_logos")
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique @map("title_url")
  description String?
  image       String?
  isActive    Boolean  @default(true) @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userType  String?
  action    String
  tableName String?  @map("table_name")
  recordId  Int?     @map("record_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model RolePermission {
  id          Int       @id @default(autoincrement())
  role        AdminRole @unique
  permissions Json      @default("[]") @map("permissions")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("role_permissions")
}

model NotificationPreference {
  id                       Int       @id @default(autoincrement())
  adminUserId              Int       @unique @map("admin_user_id")
  newCandidateAlert        Boolean   @default(true) @map("new_candidate_alert")
  contactMessageAlert      Boolean   @default(true) @map("contact_message_alert")
  calendarSyncFailureAlert Boolean   @default(true) @map("calendar_sync_failure_alert")
  sessionReminderAlert     Boolean   @default(true) @map("session_reminder_alert")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  adminUser                AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SiteSettings {
  id              Int      @id @default(1)
  siteName        String   @default("Recruitment Institute") @map("site_name")
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#0F172A") @map("primary_color")
  secondaryColor  String   @default("#1E40AF") @map("secondary_color")
  accentColor     String   @default("#EF4444") @map("accent_color")
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  defaultPageSize Int      @default(20) @map("default_page_size")
  defaultTimeZone String   @default("Asia/Kolkata") @map("default_time_zone")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  EMPLOYEE
  PURCHASE_MANAGER
  SALES_MANAGER
}

model Trainer {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String
  phone          String?
  specialization String?
  bio            String?   @db.VarChar(2000)
  image          String?
  isActive       Boolean   @default(true) @map("status")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  batches        Batch[]
  sessions       Session[]

  @@map("trainers")
}

model Batch {
  id          Int          @id @default(autoincrement())
  name        String
  courseId    Int          @map("course_id")
  trainerId   Int          @map("trainer_id")
  capacity    Int          @default(30)
  mode        BatchMode    @default(ONLINE)
  startDate   DateTime     @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  schedule    String?
  status      BatchStatus  @default(UPCOMING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  course      Course       @relation(fields: [courseId], references: [id])
  trainer     Trainer      @relation(fields: [trainerId], references: [id])
  enrollments Enrollment[]
  sessions    Session[]
  assignments Assignment[]
  feeAccounts StudentFeeAccount[]

  @@map("batches")
}

model Enrollment {
  id         Int              @id @default(autoincrement())
  studentId  Int              @map("student_id")
  batchId    Int              @map("batch_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     EnrollmentStatus @default(ENROLLED)
  student    Student          @relation(fields: [studentId], references: [id])
  batch      Batch            @relation(fields: [batchId], references: [id])
  attendance Attendance[]
  feeAccounts StudentFeeAccount[]

  @@unique([studentId, batchId])
  @@map("enrollments")
}

model Session {
  id                 Int                @id @default(autoincrement())
  batchId            Int                @map("batch_id")
  trainerId          Int                @map("trainer_id")
  title              String
  description        String?
  sessionDate        DateTime           @map("session_date") @db.Date
  startTime          DateTime           @map("start_time")
  endTime            DateTime           @map("end_time")
  meetLink           String?            @map("meet_link")
  googleEventId      String?            @map("google_event_id")
  calendarSyncStatus CalendarSyncStatus @default(NOT_SYNCED) @map("calendar_sync_status")
  calendarSyncError  String?            @map("calendar_sync_error") @db.VarChar(500)
  recurrenceGroupId  String?            @map("recurrence_group_id")
  status             SessionStatus      @default(UPCOMING)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  batch              Batch              @relation(fields: [batchId], references: [id])
  trainer            Trainer            @relation(fields: [trainerId], references: [id])
  attendance         Attendance[]
  resources          Resource[]

  @@index([recurrenceGroupId])
  @@map("sessions")
}

model Attendance {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @map("enrollment_id")
  sessionId    Int        @map("session_id")
  joinedAt     DateTime?  @map("joined_at")
  present      Boolean    @default(false)
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  session      Session    @relation(fields: [sessionId], references: [id])

  @@unique([enrollmentId, sessionId])
  @@map("attendance")
}

enum BatchMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

enum SessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum CalendarSyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED
}

model Module {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  title       String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters    Chapter[]

  @@map("lms_modules")
}

model Chapter {
  id        Int      @id @default(autoincrement())
  moduleId  Int      @map("module_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topics    Topic[]

  @@map("lms_chapters")
}

model Topic {
  id        Int      @id @default(autoincrement())
  chapterId Int      @map("chapter_id")
  title     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("lms_topics")
}

model Lesson {
  id          Int              @id @default(autoincrement())
  topicId     Int              @map("topic_id")
  title       String
  type        LessonType       @default(VIDEO)
  videoUrl    String?          @map("video_url")
  durationSec Int?             @map("duration_sec")
  bodyHtml    String?          @map("body_html") @db.Text
  sortOrder   Int              @default(0) @map("sort_order")
  isPreview   Boolean          @default(false) @map("is_preview")
  createdAt   DateTime         @default(now()) @map("created_at")
  topic       Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  resources   Resource[]
  progress    LessonProgress[]

  @@map("lms_lessons")
}

model Resource {
  id        Int          @id @default(autoincrement())
  lessonId  Int?         @map("lesson_id")
  sessionId Int?         @map("session_id")
  title     String
  fileUrl   String       @map("file_url")
  fileType  ResourceType @default(PDF)
  createdAt DateTime     @default(now()) @map("created_at")
  lesson    Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  session   Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("lms_resources")
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  studentId   Int       @map("student_id")
  lessonId    Int       @map("lesson_id")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  student     Student   @relation(fields: [studentId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("lms_lesson_progress")
}

enum LessonType {
  VIDEO
  PDF
  PPT
  ASSIGNMENT
  QUIZ
  DOWNLOAD
}

enum ResourceType {
  PDF
  PPT
  DOC
  ZIP
  VIDEO
  OTHER
}

model Assignment {
  id          Int      @id @default(autoincrement())
  batchId     Int      @map("batch_id")
  title       String
  description String?  @db.Text
  fileUrl     String?  @map("file_url")
  dueAt       DateTime @map("due_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  batch       Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           Int       @id @default(autoincrement())
  assignmentId Int       @map("assignment_id")
  studentId    Int       @map("student_id")
  fileUrl      String    @map("file_url")
  note         String?
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  score        Decimal?  @db.Decimal(5, 2)
  feedback     String?   @db.Text
  gradedAt     DateTime? @map("graded_at")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model JobQueue {
  id        Int       @id @default(autoincrement())
  type      String
  payload   Json
  status    String    @default("pending")
  attempts  Int       @default(0)
  error     String?
  runAfter  DateTime  @default(now()) @map("run_after")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("job_queue")
}

model StudentFeeAccount {
  id                Int               @id @default(autoincrement())
  studentId         Int               @map("student_id")
  batchId           Int?              @map("batch_id")
  courseId          Int               @map("course_id")
  courseFeeId       Int?              @map("course_fee_id")
  enrollmentId      Int?              @map("enrollment_id")
  planName          String            @map("plan_name")
  currency          String            @default("INR")
  grossAmount       Decimal           @map("gross_amount") @db.Decimal(12, 2)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  gstAmount         Decimal           @default(0) @map("gst_amount") @db.Decimal(12, 2)
  netPayable        Decimal           @map("net_payable") @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  refundedAmount    Decimal           @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  outstandingAmount Decimal           @map("outstanding_amount") @db.Decimal(12, 2)
  gstEnabled        Boolean           @default(false) @map("gst_enabled")
  gstRate           Decimal?          @map("gst_rate") @db.Decimal(5, 2)
  status            FeeAccountStatus  @default(PENDING)
  dueDate           DateTime?         @map("due_date") @db.Date
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  student           Student           @relation(fields: [studentId], references: [id])
  batch             Batch?            @relation(fields: [batchId], references: [id])
  course            Course            @relation(fields: [courseId], references: [id])
  courseFee         CourseFee?        @relation(fields: [courseFeeId], references: [id])
  enrollment        Enrollment?       @relation(fields: [enrollmentId], references: [id])
  invoices          FeeInvoice[]
  schedules         FeeSchedule[]
  payments          FeePayment[]
  refunds           FeeRefund[]

  @@unique([studentId, courseId, batchId])
  @@map("student_fee_accounts")
}

model FeeInvoice {
  id               Int               @id @default(autoincrement())
  feeAccountId     Int               @map("fee_account_id")
  invoiceNo        String            @unique @map("invoice_no")
  invoiceDate      DateTime          @map("invoice_date") @db.Date
  dueDate          DateTime?         @map("due_date") @db.Date
  subtotal         Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxableAmount    Decimal           @default(0) @map("taxable_amount") @db.Decimal(12, 2)
  cgstAmount       Decimal           @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount       Decimal           @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount       Decimal           @default(0) @map("igst_amount") @db.Decimal(12, 2)
  gstRate          Decimal?          @map("gst_rate") @db.Decimal(5, 2)
  totalAmount      Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount    Decimal           @default(0) @map("balance_amount") @db.Decimal(12, 2)
  roundOff         Decimal           @default(0) @map("round_off") @db.Decimal(12, 2)
  status           InvoiceStatus     @default(DRAFT)
  pdfUrl           String?           @map("pdf_url")
  gstInvoiceNo     String?           @map("gst_invoice_no")
  gstin            String?           @map("gstin")
  placeOfSupply    String?           @map("place_of_supply")
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  feeAccount       StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  items            FeeInvoiceItem[]
  payments         FeePayment[]
  refunds          FeeRefund[]

  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id           Int         @id @default(autoincrement())
  invoiceId    Int         @map("invoice_id")
  description  String
  hsnSacCode   String?     @map("hsn_sac_code")
  quantity     Int         @default(1)
  unitPrice    Decimal     @map("unit_price") @db.Decimal(12, 2)
  taxableValue Decimal     @map("taxable_value") @db.Decimal(12, 2)
  gstRate      Decimal?    @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount   Decimal     @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount   Decimal     @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount   Decimal     @default(0) @map("igst_amount") @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  invoice      FeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("fee_invoice_items")
}

model FeeSchedule {
  id              Int               @id @default(autoincrement())
  feeAccountId    Int               @map("fee_account_id")
  installmentNo   Int               @map("installment_no")
  dueDate         DateTime          @map("due_date") @db.Date
  amountDue       Decimal           @map("amount_due") @db.Decimal(12, 2)
  amountPaid      Decimal           @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status          FeeScheduleStatus @default(PENDING)
  reminderSentAt  DateTime?         @map("reminder_sent_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  feeAccount      StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)

  @@unique([feeAccountId, installmentNo])
  @@map("fee_schedules")
}

model FeePayment {
  id             Int               @id @default(autoincrement())
  feeAccountId   Int               @map("fee_account_id")
  invoiceId      Int?              @map("invoice_id")
  gateway        PaymentGateway
  gatewayRef     String?           @map("gateway_ref")
  transactionId  String?           @map("transaction_id")
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("INR")
  paymentMethod  String?           @map("payment_method")
  status         PaymentStatus     @default(PENDING)
  paidAt         DateTime?         @map("paid_at")
  rawPayload     Json?             @map("raw_payload")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  feeAccount     StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  invoice        FeeInvoice?       @relation(fields: [invoiceId], references: [id])
  refunds        FeeRefund[]

  @@index([gateway, gatewayRef])
  @@map("fee_payments")
}

model FeeRefund {
  id               Int               @id @default(autoincrement())
  feeAccountId     Int               @map("fee_account_id")
  invoiceId        Int?              @map("invoice_id")
  paymentId        Int?              @map("payment_id")
  gateway          PaymentGateway
  gatewayRefundRef String?           @map("gateway_refund_ref")
  amount           Decimal           @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus      @default(PENDING)
  processedAt      DateTime?         @map("processed_at")
  rawPayload       Json?             @map("raw_payload")
  createdAt        DateTime          @default(now()) @map("created_at")
  feeAccount       StudentFeeAccount @relation(fields: [feeAccountId], references: [id], onDelete: Cascade)
  invoice          FeeInvoice?       @relation(fields: [invoiceId], references: [id])
  payment          FeePayment?       @relation(fields: [paymentId], references: [id])

  @@map("fee_refunds")
}

enum FeeAccountStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum FeeScheduleStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}
